# Ignore build artifacts and local tooling outputs
dist/

# Node.js
node_modules/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo

# VS Code
# We track `.vscode/` in this repo (launch configs, recommended workspace settings).
# Some tools add machine-specific files here; keep only checked-in usage (launch.json)
!/.vscode/

# Extension packaging
*.vsix

# OS
.DS_Store
Thumbs.db

# Tests
coverage/

# Environment files
.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Generated by tools
.eslintcache

# Ignore output from Prettier
.prettier*

# Source maps are generated artifacts that can expose original sources; ignore in VCS
# Prefer uploading maps as CI artifacts or storing them per-build for debugging instead
*.map

# Allow build helper check script
!scripts/check-duplicate-extensions.js

# Type declarations (we allow the project's shim explicitly below)
*.d.ts

# Ignore extension dev/test artifacts
*.code-workspace

# Ignore local temporary captures used during debugging/tests
.tmp/

# Ignore artifacts from the local version-stamp tooling
.version-stamp/
package.json.bak*

# Allow this project's Svelte shim file (we ignore other .d.ts files globally)
!src/types/shims-svelte.d.ts
